APP_NAME=Mordecai Workers
NODE_ENV=development
DB_ENABLED=true

# Database
DB_NAME=your_db
DB_USER=your_user
DB_PASSWORD=your_password
DB_HOST=your_host
DB_PORT=5432
DB_SSL=true
DB_SYNC_MODE=false

# Redis (queues)
REDIS_URL=redis://127.0.0.1:6379

# Same value as mordecai-api/.env when sharing Redis with deployed workers (e.g. Upstash),
# so local API + this worker use a separate BullMQ namespace and you actually see SMS_CASE jobs here.
# BULLMQ_PREFIX=local-yourname

# Worker tuning (Collections v2 only)
WORKER_CONCURRENCY=5
WORKER_COOLDOWN_MINUTES=360
WORKER_ATTEMPTS=3

# Twilio outbound call config + SMS (SMS_CASE / sendCollectionSms runs in this process — copy MG + shortening from API .env)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+12135550123
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_SHORTEN_URLS=false
TWILIO_VOICE_URL=https://mordecai-api.duckdns.org/api/v1/twilio/voice
# Optional override; default is TWILIO_VOICE_URL + "/status" → .../api/v1/twilio/voice/status (API must expose POST /twilio/voice/status)
# TWILIO_VOICE_STATUS_CALLBACK_URL=https://mordecai-api.duckdns.org/api/v1/twilio/voice/status

# Signed voice-context contract for API /twilio/voice
CALL_CONTEXT_HMAC_SECRET=replace_with_strong_random_secret
CALL_CONTEXT_SIGNATURE_VERSION=1
CALL_CONTEXT_TTL_SECONDS=600

# SES outbound email
SES_FROM_EMAIL=no-reply@example.com
SES_REPLY_TO_EMAIL=
SES_CONFIGURATION_SET=
